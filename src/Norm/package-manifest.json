{
  "package_schema": 1,
  "name": "Norm",
  "version": "0.52.1",
  "package_type": "portable-source",
  "source_dir": "core",
  "entrypoint": "core/norm_main.py",
  "compiled_executable": "core/norm.exe",
  "settings": "config/settings.ini",
  "runtime_config": "config/runtime.json",
  "requirements_lock": "tools/requirements-lock.txt",
  "build_script": "tools/build_norm.py",
  "excluded_generated_paths": [
    ".venv",
    "staging",
    "build",
    "dist",
    "__pycache__",
    "*.pyc",
    "core/norm.exe"
  ],
  "dynamic_plugins": {
    "root": "settings.ini:[plugins].root relative to runtime root",
    "registry": "settings.ini:[plugins].registry_file relative to plugin root",
    "hydration": "native-hot-reload",
    "exposure": "public functions in non-underscore Python files",
    "private_convention": "prefix files or functions with _",
    "failure_mode": "last-known-good remains active until a valid refresh loads"
  },
  "integrity_recovery": {
    "task_lineage": "reconcile surviving IDs/UUIDs, then nearest validated-history ancestor, else detach safely",
    "memory_threads": "preserve intact links, remap from source messages, then conservatively cluster remaining orphans",
    "prune_safety": "reparent surviving children and preserve memory-thread links before destructive history pruning",
    "repair_tool": "tools/repair_norm_state.py"
  },
  "external_workspace": {
    "documents_root": "%USERPROFILE%\\Documents\\Norm",
    "workspace_root": "workspace (durable generated artifacts/work files)",
    "temp_root": "temp (auto-cleaned disposable scratch/recovery files)"
  },
  "persistent_install_paths": [
    ".venv",
    "plugins",
    ".ssh",
    "logs",
    "state"
  ],
  "backup_package": {
    "plugin": "plugins/backup",
    "includes": [
      "runtime/source",
      "docs",
      "plugins",
      ".ssh",
      "configured secrets",
      "workspace",
      "PostgreSQL dump",
      "environment rebuild metadata"
    ],
    "excludes": [
      ".venv",
      "disposable temp except recovery state"
    ],
    "modes": {
      "source": "package-managed source/docs/built-in plugins only; no secrets/private runtime state",
      "full": "source plus all plugins, .ssh, configured secrets, workspace, selected recovery/log/state, and PostgreSQL"
    }
  },
  "managed_persistent_subtrees": [
    "plugins/backup",
    "plugins/verbatim_lines",
    "plugins/stegosplit_key",
    "plugins/stegosplit_message"
  ],
  "built_in_plugins": {
    "backup": "plugins/backup",
    "verbatim_lines": "plugins/verbatim_lines",
    "stegosplit_key": "plugins/stegosplit_key",
    "stegosplit_message": "plugins/stegosplit_message"
  }
}
